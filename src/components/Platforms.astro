---
/** Platform badges (variant="badges") or the honest connection table (variant="table"). Text only — no third-party logos. */
import { t, type Lang } from '../i18n/utils';
interface Props {
  lang: Lang;
  variant?: 'badges' | 'table';
}
const { lang, variant = 'badges' } = Astro.props;
const p = t(lang).platforms;
type Method = 'api' | 'email' | 'manual';
const methods: Method[] = ['api', 'email', 'manual'];
const items = p.items.filter((i) => variant === 'table' || i.methods.length > 0).map((i) => ({
  ...i,
  methods: i.methods as Method[],
}));
const badgeItems = items.slice(0, -1); // "any other site" only in the table
---

<div class="legend" role="list">
  {
    methods.map((m) => (
      <span class="legend__item" role="listitem">
        <span class={`dot dot--${m}`} aria-hidden="true" />
        {p.legend[m]}
      </span>
    ))
  }
</div>

{
  variant === 'badges' ? (
    <ul class="badges">
      {badgeItems.map((i) => (
        <li class="pbadge">
          <span class="pbadge__name">{i.name}</span>
          <span class="pbadge__dots">
            {i.methods.map((m) => (
              <span class={`dot dot--${m}`} title={p.legend[m]}>
                <span class="visually-hidden">{p.legend[m]}</span>
              </span>
            ))}
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="table-wrap" tabindex="0" role="region" aria-label={p.cols.platform}>
      <table class="ptable">
        <thead>
          <tr>
            <th scope="col">{p.cols.platform}</th>
            <th scope="col">{p.cols.in}</th>
            <th scope="col">{p.cols.out}</th>
          </tr>
        </thead>
        <tbody>
          {items.map((i) => (
            <tr>
              <th scope="row">
                <span class="ptable__name">{i.name}</span>
                <span class="ptable__dots">
                  {i.methods.map((m) => (
                    <span class={`tag tag--${m}`}>{p.legend[m]}</span>
                  ))}
                </span>
              </th>
              <td>{i.in}</td>
              <td>
                {i.out}
                {i.note && <span class="ptable__note">{i.note}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<p class="nopass">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="4.5" y="10.5" width="15" height="10" rx="2.5"></rect><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>
  </svg>
  {p.noPasswords}
</p>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-bottom: 20px;
    color: var(--text-2);
    font-size: var(--fs-xs);
  }
  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot--api {
    background: var(--accent);
  }
  .dot--email {
    background: var(--accent-soft);
  }
  .dot--manual {
    box-shadow: inset 0 0 0 1.5px var(--text-2);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pbadge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
  }
  .pbadge__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .pbadge__dots {
    display: inline-flex;
    gap: 5px;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--card);
  }
  .ptable {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .ptable th,
  .ptable td {
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .ptable tbody tr:last-child > * {
    border-bottom: 0;
  }
  .ptable thead th {
    color: var(--text-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ptable td {
    color: var(--text-2);
  }
  .ptable__name {
    display: block;
    font-size: 1rem;
    font-weight: 600;
  }
  .ptable__dots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .tag {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  .tag--api {
    background: rgba(255, 107, 0, 0.16);
    color: var(--accent-soft);
  }
  .tag--email {
    background: rgba(255, 210, 176, 0.1);
    color: var(--accent-soft);
  }
  .tag--manual {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-2);
  }
  .ptable__note {
    display: block;
    margin-top: 8px;
    color: var(--accent-text);
    font-size: var(--fs-xs);
  }
  .nopass {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 24px;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .nopass svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }
</style>
