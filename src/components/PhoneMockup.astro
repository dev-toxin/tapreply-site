---
/**
 * HTML/CSS phone mockup with the Tourist Shield card.
 * The four steps cycle with a pure-CSS animation (opacity/transform only).
 * With prefers-reduced-motion the steps are shown as a static stacked list.
 */
import { t, type Lang } from '../i18n/utils';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.shield;
const short = ['DE', lang.toUpperCase(), 'DE', lang.toUpperCase()];
---

<div class="mock" role="img" aria-label={`${d.common.example}: ${s.name} — ${s.steps.map((x) => x.label).join(' → ')}`}>
  <div class="mock__glow" aria-hidden="true"></div>
  <div class="phone" aria-hidden="true">
    <div class="phone__notch"></div>
    <div class="phone__status">
      <span>9:41</span>
      <span class="phone__status-icons">
        <i></i><i></i><i></i>
      </span>
    </div>

    <div class="app">
      <div class="app__bar">
        <img src="/brand/logo-96.webp" width="28" height="28" alt="" />
        <span class="app__title">{s.name}</span>
        <span class="app__example">{d.common.example}</span>
      </div>

      <div class="review">
        <div class="review__meta">
          <span class="review__avatar">{s.guest.charAt(0)}</span>
          <div>
            <div class="review__name">{s.guest}</div>
            <div class="review__sub">{s.platform} · {s.time}</div>
          </div>
          <span class="review__stars">
            <b>★★★★</b><span>★</span>
          </span>
        </div>
        <div class="review__venue">{s.venue}</div>
      </div>

      <ol class="steps">
        {
          s.steps.map((step, i) => (
            <li class={`steps__dot steps__dot--${i}`}>
              <span />
            </li>
          ))
        }
      </ol>

      <div class="stage">
        {
          s.steps.map((step, i) => (
            <div class:list={['block', `block--${i}`, { 'block--reply': step.key === 'reply' }]}>
              <div class="block__head">
                <span class="block__label">{step.label}</span>
                <span class="block__lang">{short[i]}</span>
              </div>
              <p class="block__text">{step.text}</p>
            </div>
          ))
        }
      </div>

      <div class="app__actions">
        <span class="app__btn app__btn--ghost">{s.edit}</span>
        <span class="app__btn">{s.approve}</span>
      </div>
      <p class="app__note">{s.youConfirm}</p>
    </div>
  </div>
</div>

<style>
  .mock {
    position: relative;
    width: min(100%, 360px);
    margin-inline: auto;
  }
  .mock__glow {
    position: absolute;
    inset: 10% -18% 0;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 107, 0, 0.22), transparent);
    pointer-events: none;
  }
  .phone {
    position: relative;
    z-index: 1;
    padding: 12px;
    border: 1px solid var(--line-strong);
    border-radius: 44px;
    background: linear-gradient(160deg, #2a2a30, #151518 60%);
    box-shadow: var(--shadow), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .phone__notch {
    position: absolute;
    top: 22px;
    left: 50%;
    z-index: 2;
    width: 92px;
    height: 24px;
    margin-left: -46px;
    border-radius: 14px;
    background: #050506;
  }
  .phone__status {
    display: flex;
    justify-content: space-between;
    padding: 14px 26px 0;
    border-radius: 34px 34px 0 0;
    background: var(--bg);
    font-size: 12px;
    font-weight: 600;
  }
  .phone__status-icons {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .phone__status-icons i {
    display: block;
    width: 14px;
    height: 8px;
    border-radius: 2px;
    background: var(--text-2);
  }
  .phone__status-icons i:nth-child(1) {
    width: 4px;
    height: 8px;
  }
  .phone__status-icons i:nth-child(2) {
    width: 10px;
    height: 8px;
    border-radius: 5px 5px 2px 2px;
  }
  .app {
    padding: 18px 14px 16px;
    border-radius: 0 0 34px 34px;
    background: var(--bg);
  }
  .app__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    margin-bottom: 14px;
  }
  .app__bar img {
    border-radius: 8px;
  }
  .app__title {
    font-size: 15px;
    font-weight: 600;
  }
  .app__example {
    margin-left: auto;
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 11px;
  }
  .review {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
  }
  .review__meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .review__avatar {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: #2c2c33;
    font-size: 13px;
    font-weight: 600;
  }
  .review__name {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }
  .review__sub,
  .review__venue {
    color: var(--text-2);
    font-size: 11.5px;
    line-height: 1.4;
  }
  .review__venue {
    margin-top: 8px;
  }
  .review__stars {
    margin-left: auto;
    font-size: 13px;
    letter-spacing: 1px;
  }
  .review__stars b {
    color: var(--accent-text);
    font-weight: 400;
  }
  .review__stars span {
    color: #4a4a52;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin: 14px 2px 10px;
    padding: 0;
    list-style: none;
  }
  .steps__dot {
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }
  .steps__dot span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .stage {
    display: grid;
    min-height: 212px;
  }
  .block {
    grid-area: 1 / 1;
    align-self: start;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
  }
  .block--reply {
    border-color: rgba(255, 107, 0, 0.35);
    background: linear-gradient(180deg, rgba(255, 107, 0, 0.1), rgba(255, 107, 0, 0.03)), var(--card);
  }
  .block__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .block__label {
    color: var(--accent-text);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .block__lang {
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-2);
    font-size: 10.5px;
    font-weight: 600;
  }
  .block__text {
    color: #e6e6ec;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .app__actions {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 8px;
    margin-top: 12px;
  }
  .app__btn {
    display: grid;
    min-height: 42px;
    place-items: center;
    border-radius: 12px;
    background: var(--accent);
    color: #121214;
    font-size: 13px;
    font-weight: 600;
  }
  .app__btn--ghost {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
  }
  .app__note {
    margin-top: 10px;
    color: var(--text-2);
    font-size: 11px;
    text-align: center;
  }

  /* ---------- Animation: 4 steps × 3.5s ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .block {
      opacity: 0;
      animation: step 14s var(--ease) infinite;
    }
    .block--1 {
      animation-delay: 3.5s;
    }
    .block--2 {
      animation-delay: 7s;
    }
    .block--3 {
      animation-delay: 10.5s;
    }
    .block--0 {
      /* first frame visible immediately (no blank phone on load) */
      animation-name: step-first;
    }
    .steps__dot span {
      animation: bar 14s linear infinite;
    }
    .steps__dot--1 span {
      animation-delay: 3.5s;
    }
    .steps__dot--2 span {
      animation-delay: 7s;
    }
    .steps__dot--3 span {
      animation-delay: 10.5s;
    }
  }
  @keyframes step {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    3%,
    23% {
      opacity: 1;
      transform: none;
    }
    26%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @keyframes step-first {
    0%,
    23% {
      opacity: 1;
      transform: none;
    }
    26% {
      opacity: 0;
      transform: translateY(-6px);
    }
    97% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes bar {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    25% {
      transform: scaleX(1);
      opacity: 1;
    }
    26%,
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  /* Reduced motion: static, all four steps stacked */
  @media (prefers-reduced-motion: reduce) {
    .stage {
      gap: 8px;
    }
    .block {
      grid-area: auto;
    }
    .steps {
      display: none;
    }
  }
</style>
