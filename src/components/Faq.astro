---
interface Props {
  items: { q: string; a: string }[];
  headingLevel?: 'h2' | 'h3';
}
const { items, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <H class="faq__q">{item.q}</H>
          <span class="faq__toggle" aria-hidden="true" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 10px;
  }
  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--card);
    transition: border-color 0.18s var(--ease);
  }
  .faq__item[open] {
    border-color: var(--line-strong);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-md);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .faq__toggle {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 1.5px;
    margin: -0.75px 0 0 -5.5px;
    background: var(--text-2);
    transition: transform 0.2s var(--ease);
  }
  .faq__toggle::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__toggle::after {
    transform: rotate(0deg);
  }
  .faq__a {
    padding: 0 22px 22px;
    color: var(--text-2);
    max-width: 68ch;
  }
  /* On light sections (better reading on a phone in daylight). */
  :global(.section--light) .faq__item {
    border-color: rgba(24, 24, 27, 0.1);
    background: var(--light-card);
    color: var(--light-text);
  }
  :global(.section--light) .faq__item[open] {
    border-color: rgba(24, 24, 27, 0.2);
  }
  :global(.section--light) .faq__toggle {
    border-color: rgba(24, 24, 27, 0.2);
  }
  :global(.section--light) .faq__toggle::before,
  :global(.section--light) .faq__toggle::after {
    background: var(--light-text-2);
  }
  :global(.section--light) .faq__a {
    color: var(--light-text-2);
  }
</style>
