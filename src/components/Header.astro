---
import Button from './Button.astro';
import { LANGS, LANG_LABELS, href, t, type Lang, type PageKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageKey | '404';
}
const { lang, page } = Astro.props;
const d = t(lang);
const target: PageKey = page === '404' ? '' : page;

const links: { key: PageKey; label: string }[] = [
  { key: 'features', label: d.nav.features },
  { key: 'how-it-works', label: d.nav.how },
  { key: 'pricing', label: d.nav.pricing },
  { key: 'faq', label: d.nav.faq },
  { key: 'about', label: d.nav.about },
];
---

<header class="hdr">
  <div class="container hdr__inner">
    <a class="hdr__brand" href={href(lang)} aria-label={d.common.homeLabel}>
      <img src="/brand/logo-96.webp" width="32" height="32" alt="" />
      <span>TapReply</span>
    </a>

    <nav class="hdr__nav" aria-label={d.common.menu}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={href(lang, l.key)} aria-current={page === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__right">
      <nav class="lang" aria-label={d.common.langSwitch}>
        {
          LANGS.map((l) => (
            <a
              href={href(l, target)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              title={LANG_LABELS[l].native}
            >
              <span aria-hidden="true">{LANG_LABELS[l].short}</span>
              <span class="visually-hidden">{LANG_LABELS[l].native}</span>
            </a>
          ))
        }
      </nav>
      <Button href={href(lang, 'pilot')} class="hdr__cta">{d.common.ctaPilot}</Button>

      <details class="mnav">
        <summary aria-label={d.common.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path class="mnav__open" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="mnav__close" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <div class="mnav__panel">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={href(lang, l.key)} aria-current={page === l.key ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={href(lang, 'pilot')} aria-current={page === 'pilot' ? 'page' : undefined}>{d.nav.pilot}</a>
            </li>
          </ul>
          <Button href={href(lang, 'pilot')} size="lg" class="mnav__cta">{d.common.ctaPilot}</Button>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(18, 18, 20, 0.82);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    backdrop-filter: saturate(140%) blur(14px);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 68px;
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .hdr__brand img {
    border-radius: 9px;
  }
  .hdr__nav {
    display: none;
    margin-left: 12px;
  }
  .hdr__nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr__nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s var(--ease), background-color 0.15s var(--ease);
  }
  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  .hdr__right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .lang {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 11px;
  }
  .lang a {
    display: grid;
    min-width: 34px;
    min-height: 32px;
    padding: 0 6px;
    place-items: center;
    border-radius: 8px;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a[aria-current='true'] {
    background: rgba(255, 255, 255, 0.09);
    color: var(--text);
  }
  :global(.hdr__cta) {
    display: none !important;
  }

  .mnav {
    position: relative;
  }
  .mnav summary {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    list-style: none;
  }
  .mnav summary::-webkit-details-marker {
    display: none;
  }
  .mnav__close {
    display: none;
  }
  .mnav[open] .mnav__close {
    display: block;
  }
  .mnav[open] .mnav__open {
    display: none;
  }
  .mnav__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(86vw, 320px);
    padding: 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .mnav__panel ul {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }
  .mnav__panel a:not(.btn) {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    font-weight: 500;
    text-decoration: none;
  }
  .mnav__panel a:not(.btn):hover,
  .mnav__panel a[aria-current='page'] {
    background: rgba(255, 255, 255, 0.05);
  }
  :global(.mnav__cta) {
    width: 100%;
  }

  @media (min-width: 1040px) {
    .hdr__nav {
      display: block;
    }
    .mnav {
      display: none;
    }
    :global(.hdr__cta) {
      display: inline-flex !important;
    }
  }
</style>
