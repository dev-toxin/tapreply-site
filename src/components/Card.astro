---
import Icon from './Icon.astro';
interface Props {
  icon?: string;
  title?: string;
  text?: string;
  class?: string;
  as?: 'article' | 'div' | 'li';
  headingLevel?: 'h2' | 'h3';
}
const { icon, title, text, class: cls, as = 'article', headingLevel = 'h3' } = Astro.props;
const Tag = as;
const H = headingLevel;
---

<Tag class:list={['card', cls]}>
  {
    icon && (
      <span class="card__icon">
        <Icon name={icon} />
      </span>
    )
  }
  {title && <H class="card__title">{title}</H>}
  {text && <p class="card__text">{text}</p>}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    padding: clamp(22px, 2.6vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--card);
  }
  .card__icon {
    display: inline-grid;
    width: 44px;
    height: 44px;
    margin-bottom: 20px;
    place-items: center;
    border: 1px solid rgba(255, 107, 0, 0.2);
    border-radius: 12px;
    background: var(--accent-tint);
    color: var(--accent-text);
  }
  .card__title {
    font-size: var(--fs-h3);
  }
  .card__text {
    margin-top: 10px;
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
</style>
