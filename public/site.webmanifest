  "icons": [
    { "src": "/brand/logo-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/logo-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
